 void XNotifyUI(XNOTIFYQUEUEUI_TYPE Type, PWCHAR String) { XNotifyQueueUI(Type, XUSER_INDEX_ANY, XNOTIFYUI_PRIORITY_DEFAULT, String, 0); }
 
+// Diagnostic log for retail consoles, where DbgPrint goes nowhere. The USB callbacks
+// can't touch files or XNotify, so they only format into a ring buffer; the mapping
+// manager thread flushes it to HDD:\hiddriver_log.txt.
+#define DIAG_LOG_PATH "HDD:\\hiddriver_log.txt"
+#define DIAG_SLOTS 256
+#define DIAG_LINE 192
+struct DiagSlot {
+	volatile LONG seq;
+	char text[DIAG_LINE];
+};
+DiagSlot g_diagSlots[DIAG_SLOTS];
+volatile LONG g_diagWrite = 0;
+LONG g_diagRead = 0;
+
+// Last device seen by HidAddDeviceHook, announced on screen by the manager thread
+struct DiagDevice {
+	volatile LONG seq;
+	uint16_t vendorId, productId;
+	uint8_t cls, subCls, proto;
+};
+DiagDevice g_diagDevice;
+
+ULONG DiagLog(const char* fmt, ...) {
+	LONG idx = InterlockedIncrement(&g_diagWrite) - 1;
+	DiagSlot* slot = &g_diagSlots[idx % DIAG_SLOTS];
+	va_list args;
+	va_start(args, fmt);
+	_vsnprintf(slot->text, DIAG_LINE - 1, fmt, args);
+	va_end(args);
+	slot->text[DIAG_LINE - 1] = 0;
+	__lwsync();
+	slot->seq = idx + 1;
+	return 0;
+}
+
+void DiagFlush() {
+	FILE* f = nullptr;
+	while (true) {
+		DiagSlot* slot = &g_diagSlots[g_diagRead % DIAG_SLOTS];
+		LONG seq = slot->seq;
+		if (seq <= g_diagRead)
+			break;
+		if (!f && !(f = fopen(DIAG_LOG_PATH, "a")))
+			return;
+		if (seq > g_diagRead + 1) {
+			// writer lapped the ring, skip ahead to the oldest line still there
+			fprintf(f, "[... %d lines lost ...]\n", (int)(seq - 1 - g_diagRead));
+			g_diagRead = seq - 1;
+		}
+		fputs(slot->text, f);
+		size_t len = strlen(slot->text);
+		if (!len || slot->text[len - 1] != '\n')
+			fputc('\n', f);
+		g_diagRead++;
+	}
+	if (f)
+		fclose(f);
+}
+
+#define DbgPrint DiagLog
